PORT=3000
LOG_LEVEL=info

# --- Docker Compose (service-to-service) ---
MONGODB_URI=mongodb://mongo:27017/sync
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:9092

# --- Local host override (npm run dev on host machine) ---
# MONGODB_URI=mongodb://localhost:27017/sync
# REDIS_URL=redis://localhost:6379
# KAFKA_BROKERS=localhost:29092

KAFKA_CONSUMER_GROUP=sync-service
KAFKA_CDC_TOPIC_PREFIX=business.cdc.public.
KAFKA_TOPIC_REFRESH_INTERVAL_MS=30000

JWKS_URL=http://rbac-service:8080/.well-known/jwks.json
JWT_ISSUER=https://auth.wingsure.local

RBAC_GRPC_ADDRESS=rbac-service:9090
RBAC_GRPC_TIMEOUT_MS=2000

OPLOG_TTL_DAYS=30
PULL_DEFAULT_LIMIT=500
PULL_MAX_LIMIT=1000

# Postgres read replica (optional — snapshot endpoint disabled if unset)
PG_READ_REPLICA_URL=postgres://rbac:rbac@postgres:5432/rbac
# PG_READ_REPLICA_URL=postgres://rbac:rbac@localhost:5432/rbac   # host override

# Schema migration coordination
SCHEMA_ROLLOUT_PERCENT=100
SCHEMA_MIN_SUPPORTED_VERSION=1
SCHEMA_KILL_SWITCH=false

# OpenTelemetry (optional — traces disabled if unset)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
